{
  "name": "openchamber-zentao-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "禅道助手 — 在 OpenChamber 右侧面板里连接禅道、按项目/迭代/成员筛选 bug，并把 bug 交给当前会话做 AI 修复。",
  "type": "module",
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "bunx openchamber-guest-bundle src/panel.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node src/service.ts service/main.js",
    "typecheck": "tsc --noEmit"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "zentao-bug-assistant",
        "name": "禅道助手",
        "icon": "panel/icon.svg",
        "entry": "panel/index.html"
      },
      "attach": "panel",
      "page": true,
      "capabilities": ["prompt", "sessions"],
      "actions": [
        {
          "id": "zentao-writeback",
          "label": "回写禅道并标记已解决",
          "icon": "bug-line",
          "where": "session",
          "payload": ["messages"]
        }
      ],
      "commands": [
        {
          "name": "zentao",
          "description": "把一条禅道 bug 挂到当前会话（/zentao 3986）"
        }
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3"
  }
}